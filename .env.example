# 会话签名密钥（生产必须设置；留空则每次启动随机生成，重启后所有会话失效）
SECRET_KEY=

# HTTPS 部署时设为 true，cookie 仅经加密连接发送
SECURE_COOKIES=false

# 数据库（默认 SQLite 于 data/invoices.db）
# DATABASE_URL=sqlite:///data/invoices.db

# 存储路径（Docker/K8s 下指向持久卷）
# UPLOAD_FOLDER=/data/uploads
# OUTPUT_DIR=/data/output

# 上传大小限制（MB）
# MAX_UPLOAD_MB=16

# 腾讯云OCR API密钥（建议通过Web界面系统设置页面配置；此处配置仅用于首次启动导入）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# vLLM / OpenAI 兼容 OCR 后端（可选）
# VLLM_OCR_ENDPOINT=https://api.siliconflow.cn/v1
# VLLM_OCR_API_KEY=
# VLLM_OCR_MODEL=deepseek-ai/DeepSeek-OCR

# 本地开发
# DEV_RELOAD=1
# PORT=5001
